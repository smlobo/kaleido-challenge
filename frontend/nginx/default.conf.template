# Filled in at container start: ${TICKETING_URL} is the ticketing service.
server {
    listen 8080;
    root /usr/share/nginx/html;

    # /api/x -> ${TICKETING_URL}/x, like the Vite dev proxy.
    location /api/ {
        proxy_pass ${TICKETING_URL}/;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 30s;
    }

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Built assets have content hashes in their names: cache them for good.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # The page itself: always check for a new build.
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}
